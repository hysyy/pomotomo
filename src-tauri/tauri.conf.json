{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomoTomo",
  "version": "0.1.0",
  "identifier": "com.pomotomo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PomoTomo",
        "width": 390,
        "height": 460,
        "minWidth": 300,
        "minHeight": 220,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#f6f0e8"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "HySy"
  }
}